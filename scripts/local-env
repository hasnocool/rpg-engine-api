#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
ACTION="${1:-up}"
CONTAINER_NAME="${RPG_ENGINE_POSTGRES_CONTAINER:-rpg-engine-postgres}"
VOLUME_NAME="${CONTAINER_NAME}-data"
POSTGRES_IMAGE="${RPG_ENGINE_POSTGRES_IMAGE:-postgres:16-alpine}"

have_compose() {
  docker compose version >/dev/null 2>&1
}

wait_for_postgres() {
  local target="$1"
  local attempt
  for attempt in {1..30}; do
    if docker exec "$target" pg_isready -U rpg -d rpg_engine >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  docker logs "$target" || true
  return 1
}

start_with_docker_run() {
  docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
  docker volume create "$VOLUME_NAME" >/dev/null
  docker run -d \
    --name "$CONTAINER_NAME" \
    -p 5432:5432 \
    -e POSTGRES_USER=rpg \
    -e POSTGRES_PASSWORD=rpg \
    -e POSTGRES_DB=rpg_engine \
    -v "$VOLUME_NAME:/var/lib/postgresql/data" \
    "$POSTGRES_IMAGE" >/dev/null
  wait_for_postgres "$CONTAINER_NAME"
}

stop_with_docker_run() {
  docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
}

case "$ACTION" in
  up)
    if have_compose; then
      docker compose up -d postgres
      wait_for_postgres "$(docker compose ps -q postgres)"
    else
      start_with_docker_run
    fi
    echo "PostgreSQL requested. Export for this shell:"
    echo 'export RPG_ENGINE_DATABASE_URL="postgresql+asyncpg://rpg:rpg@127.0.0.1:5432/rpg_engine"'
    ;;
  down)
    if have_compose; then
      docker compose down
    else
      stop_with_docker_run
    fi
    ;;
  reset)
    if have_compose; then
      docker compose down -v
      docker compose up -d postgres
      wait_for_postgres "$(docker compose ps -q postgres)"
    else
      stop_with_docker_run
      docker volume rm "$VOLUME_NAME" >/dev/null 2>&1 || true
      start_with_docker_run
    fi
    ;;
  *)
    echo "usage: $0 {up|down|reset}" >&2
    exit 2
    ;;
esac
